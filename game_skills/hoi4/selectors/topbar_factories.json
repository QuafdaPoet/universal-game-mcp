{
  "selector_id": "topbar_factories",
  "name": "Topbar Factories Indicator",
  "description": "Locates the civilian/military factory counter on the top resource bar",
  "type": "composite",
  "strategy": {
    "primary": "template_match",
    "secondary": "ocr_text"
  },
  "search_roi": {
    "x": 0.25,
    "y": 0.0,
    "width": 0.12,
    "height": 0.05
  },
  "template": {
    "template_file": "templates/civilian_factory.png",
    "threshold": 0.82,
    "multi_scale": true
  },
  "text_criteria": {
    "pattern": "\\d+",
    "case_sensitive": false
  },
  "hover_verification": {
    "enabled": true,
    "duration_ms": 250,
    "expected_tooltip_contains": "Factories"
  },
  "ambiguity_handling": {
    "strategy": "reject_or_escalate",
    "score_tolerance": 0.05
  }
}
