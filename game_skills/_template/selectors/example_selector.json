{
  "selector_id": "example_selector",
  "name": "Example Menu Button",
  "description": "Example UI element combining template matching with OCR text verification",
  "type": "composite",
  "strategy": {
    "primary": "template_match",
    "secondary": "ocr_text"
  },
  "search_roi": {
    "x": 0.0,
    "y": 0.0,
    "width": 1.0,
    "height": 0.15
  },
  "template": {
    "template_file": "templates/example_icon.png",
    "threshold": 0.80,
    "multi_scale": true
  },
  "text_criteria": {
    "pattern": "Settings|Options",
    "case_sensitive": false
  },
  "hover_verification": {
    "enabled": true,
    "duration_ms": 300,
    "expected_tooltip_contains": "Open Options"
  },
  "ambiguity_handling": {
    "strategy": "reject_or_escalate",
    "score_tolerance": 0.05
  }
}
